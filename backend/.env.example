# Backend Environment Configuration

# Database URL - PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/banco_dados
DATABASE_URL=postgresql://saae:senha_secreta@localhost:5432/saae_arapiraca

# Secret key para JWT - Gere uma chave segura
# Pode usar: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua_chave_secreta_muito_segura_aqui_minimo_32_caracteres

# Algoritmo JWT (padrão: HS256)
ALGORITHM=HS256

# Tempo de expiração do token em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30
